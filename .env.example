# Notion integration token (internal integration, given access to the DBs below).
# https://www.notion.so/profile/integrations/internal
NOTION_TOKEN=secret_xxx

# Distillation DBs (Long-Term Memory). 14 total. Paste each DB's 32-char ID.
NOTION_PEOPLE_DB_ID=
NOTION_COMPANIES_DB_ID=
NOTION_AGENTS_DB_ID=
NOTION_PROJECTS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_DECISIONS_DB_ID=
NOTION_FRAMEWORKS_DB_ID=
NOTION_STRATEGIES_DB_ID=
NOTION_INSIGHTS_DB_ID=
NOTION_PATTERNS_DB_ID=
NOTION_SIGNALS_DB_ID=
NOTION_GLOSSARY_DB_ID=
NOTION_OBJECTIVES_DB_ID=
NOTION_METRICS_DB_ID=

# Source DB (Short-Term Memory). Optional — only source workers and the Hindsight
# Indexer use this. The frontend feed doesn't need it.
NOTION_SHORT_TERM_MEMORY_DB_ID=

# Hindsight Cloud — the memory engine for Cerebro V1.
# Bank `Cerebro` was auto-created at signup; the spec calls this slot
# `optemization-cerebro` (rename when/if we provision a fresh bank).
# Retrieve the API key from 1Password:
#   op item get "Hindsight Cloud API key" --vault="Optemization Automation" \
#     --fields credential --reveal
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_NAMESPACE=default
HINDSIGHT_BANK_ID=Cerebro

# ElevenLabs — Ask Cerebro voice + chat surface.
# API key: elevenlabs.io → Settings → Profile + API Key (server-side only).
# Agent ID: copy from the agent editor after creating "Ask Cerebro".
# Shared secret: generate with `openssl rand -hex 32`. Paste the same value
# into the askCerebro webhook tool's `x-cerebro-key` header (as a Secret).
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
CEREBRO_SHARED_SECRET=

# LiveAvatar (HeyGen) — real-time video avatar that wraps the ElevenLabs agent.
# 1. Sign up at https://app.liveavatar.com, grab API key from /developers.
# 2. Register ELEVENLABS_API_KEY as a LiveAvatar secret (one-time curl):
#      curl -X POST https://api.liveavatar.com/v1/secrets \
#        -H "X-Api-Key: $LIVEAVATAR_API_KEY" -H "Content-Type: application/json" \
#        -d '{"secret_type":"ELEVENLABS_API_KEY","secret_value":"'"$ELEVENLABS_API_KEY"'","secret_name":"cerebro-prod"}'
#    Paste the returned secret_id below.
# 3. Pick a public avatar in the dashboard, paste its avatar_id below.
LIVEAVATAR_API_KEY=
LIVEAVATAR_SECRET_ID=
NEXT_PUBLIC_LIVEAVATAR_AVATAR_ID=
# Optional: ElevenLabs voice_id to override the agent's default voice for
# LiveAvatar sessions only (e.g. a Santa-flavored voice while the text/voice
# chat surfaces keep the agent's normal voice). Find it at
# elevenlabs.io → Voices → click a voice → ID. Leave empty to use the agent default.
LIVEAVATAR_VOICE_ID=
