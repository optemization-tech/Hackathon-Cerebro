# Notion integration token (internal integration, given access to all source/output databases).
# https://www.notion.so/profile/integrations/internal
NOTION_TOKEN=secret_xxx

# Source: Notion database (or data source) ID of meeting notes to ingest.
NOTION_MEETINGS_DB_ID=

# Output: distilled record databases. Create these in Notion, share with the
# integration, then paste their IDs here.
NOTION_DECISIONS_DB_ID=
NOTION_THEMES_DB_ID=
NOTION_ENTITIES_DB_ID=
NOTION_OPEN_QUESTIONS_DB_ID=
NOTION_CULTURAL_SIGNALS_DB_ID=

# LLM for distillation.
ANTHROPIC_API_KEY=sk-ant-xxx

# Shared secret for /api/ingest. Vercel Cron will pass this in the
# `authorization` header automatically when set via Vercel env vars.
CRON_SECRET=replace-me-with-a-long-random-string

# Hindsight Cloud — the memory engine for Cerebro V1.
# Bank `Cerebro` was auto-created at signup; the spec calls this slot
# `optemization-cerebro` (rename when/if we provision a fresh bank).
# Retrieve the API key from 1Password:
#   op item get "Hindsight Cloud API key" --vault="Optemization Automation" \
#     --fields credential --reveal
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_NAMESPACE=default
HINDSIGHT_BANK_ID=Cerebro
