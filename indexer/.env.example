# Notion integration token with read/write access to the Short-Term Memory DB.
# Create at https://www.notion.so/profile/integrations/internal
NOTION_API_TOKEN=secret_xxx

# Hindsight Cloud — the memory engine for Cerebro.
# Bank ID `Cerebro`, namespace `default`.
# Retrieve the API key from 1Password:
#   op item get "Hindsight Cloud API key" --vault="Optemization Automation" \
#     --fields credential --reveal
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_NAMESPACE=default
HINDSIGHT_BANK_ID=Cerebro
