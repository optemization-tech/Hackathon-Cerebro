# Notion integration token. Must have:
#   - the Short-Term Memory DB (read + write Status property)
#   - read access on every row's page body content
#
# NOTE: Personal Access Tokens (PATs) cannot list users — the worker logs a
# warning and falls back to per-row notion.users.retrieve, which also fails
# under PAT scope. Result: rows are still indexed, but the person-source:<slug>
# tag is omitted. Use an internal integration token if you need that tag.
NOTION_API_TOKEN=secret_xxx

# Hindsight Cloud bearer token. Retrieve via 1Password:
#   op item get "Hindsight Cloud API key" --vault="Optemization Automation" \
#     --fields credential --reveal
HINDSIGHT_API_KEY=

# Hindsight Cloud bank identifier (URL path segment). The live bank is
# "Cerebro". Override if we ever rotate.
HINDSIGHT_BANK_ID=Cerebro

# Hindsight Cloud namespace + base URL — almost never need to change.
HINDSIGHT_NAMESPACE=default
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
