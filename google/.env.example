# Notion integration token. Must have access to:
#   - the Glossary DB (read)
#   - the Short-Term Memory DB (write)
# Create at: https://www.notion.so/profile/integrations/internal
NOTION_API_TOKEN=secret_xxx

# Google Workspace domain-wide delegation. The service account JSON
# (base64 encoded) impersonates an admin to enumerate users, then
# impersonates each user to read their GMail + Calendar.
# Retrieve via 1Password:
#   op item get "Cerebro Google service account" --vault="Optemization Automation" \
#     --fields credential --reveal
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
GOOGLE_ADMIN_EMAIL=admin@optemization.com
GOOGLE_WORKSPACE_DOMAIN=optemization.com

# Glossary data source ID. Resolve from the database ID with:
#   ntn datasources resolve <db-id>
# When unset, the worker skips glossary normalization.
GLOSSARY_DATA_SOURCE_ID=

# Short-Term Memory data source ID is hardcoded in src/index.ts —
# shared across every Cerebro source worker.
