# Notion internal integration token. Required for syncs (granolaMeetingsBackfill,
# granolaMeetingsDelta) so the worker can write to the Short-Term Memory database.
# The ingestGranolaMeetings tool is pre-authenticated when invoked from a Notion
# Custom Agent and does not need this set in that path.
#
# Create at: https://www.notion.so/profile/integrations/internal
# Grant the integration access to the Short-Term Memory DB before deploying.
NOTION_API_TOKEN=ntn_...

# Granola.so API key. Retrieve from Granola desktop: Settings → Connectors → API keys.
GRANOLA_API_KEY=grn_...
