# Notion integration token. Must have access to:
#   - the Glossary DB (read)
#   - the configured source data sources (read) — e.g. Optemization Docs DB
#   - the Short-Term Memory DB (write)
# Create at: https://www.notion.so/profile/integrations/internal
NOTION_API_TOKEN=secret_xxx

# Optemization Docs DB data source ID. Resolve from the DB ID with:
#   ntn datasources resolve 7770dd47209b49098dad46ec0d4dcb3b
OPTEMIZATION_DOCS_DATA_SOURCE_ID=

# (Optional) Granola↔Notion mirror destination DB data source ID. If Tem's
# Granola mirror is enabled and the mirror lands in a Notion DB this
# integration can read, set the data source ID here and the worker will
# also ingest those meeting rows with Source=Granola.
GRANOLA_DATA_SOURCE_ID=

# Glossary data source ID. Resolve from the database ID with:
#   ntn datasources resolve <db-id>
GLOSSARY_DATA_SOURCE_ID=
