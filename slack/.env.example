# Notion integration token. Must have access to:
#   - the Glossary DB (read)
#   - the Short-Term Memory DB (write)
# Create at: https://www.notion.so/profile/integrations/internal
NOTION_API_TOKEN=secret_xxx

# Slack bot token (xoxb-...). Required for the worker to read messages.
# Retrieve via 1Password:
#   op item get "Cerebro Slack bot" --vault="Optemization Automation" --fields credential --reveal
SLACK_BOT_TOKEN=xoxb-...

# Glossary data source ID. Resolve from the database ID with:
#   ntn datasources resolve <db-id>
# When unset, the worker skips glossary normalization and writes raw cleaned text
# with an empty Entities array. The Indexer Worker still indexes those rows.
GLOSSARY_DATA_SOURCE_ID=

# Slack Channels data source ID. Used by the brief pipeline to discover
# Active channels with engagement/category metadata.
# Resolve from the database ID with:
#   ntn datasources resolve 362a4866-2b25-8178-b5ac-d94f6119ca06
SLACK_CHANNELS_DATA_SOURCE_ID=5700cc0a-fe5b-4e9d-b5e1-60dc0899a85d

# People data source ID. Used by glossary normalization to resolve people entities.
PEOPLE_DATA_SOURCE_ID=

# Companies data source ID. Used by glossary normalization to resolve company entities.
COMPANIES_DATA_SOURCE_ID=

# Anthropic API key for LLM-generated daily briefs.
# Retrieve via 1Password:
#   op item get "Anthropic API Key" --vault="Optemization Automation" --fields credential --reveal
ANTHROPIC_API_KEY=sk-ant-...

# Short-Term Memory data source ID is hardcoded in src/index.ts —
# shared across every Cerebro source worker. No env override needed.
