# Notion integration token. Must have access to:
#   - the Calendar DB (read)
#   - the Short-Term Memory DB (write)
# Create at: https://www.notion.so/profile/integrations/internal
NOTION_API_TOKEN=secret_xxx

# Data source ID of the Notion Calendar DB. The database ID is
# f69027a8577d4db3b20be1a1c00881e0 — resolve its data source ID with:
#   ntn datasources resolve f69027a8577d4db3b20be1a1c00881e0
# Or via SDK: notion.databases.retrieve({ database_id }).data_sources[0].id
CALENDAR_DATA_SOURCE_ID=

# Short-Term Memory data source ID is hardcoded in src/index.ts —
# shared with the slack/ worker. No env override needed unless rotating
# the DB.
