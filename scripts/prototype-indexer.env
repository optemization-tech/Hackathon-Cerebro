# Env references for scripts/prototype-indexer.mjs.
# Resolved by `op run --env-file=scripts/prototype-indexer.env -- ...`.
#
# IMPORTANT: replace `<your-notion-token-item-name>` below with the actual
# 1Password item title for your Notion integration token. Hint: it's the
# same item the `_ntn_op` helper in ~/.zshrc references.
#
# If you'd rather paste the token inline once instead, run:
#   NOTION_API_TOKEN='secret_xxx' op run --env-file=scripts/setup-hindsight.env -- \
#     node scripts/prototype-indexer.mjs --limit 2 --dry-run
NOTION_API_TOKEN=op://Optemization Automation/<your-notion-token-item-name>/credential

HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=op://Optemization Automation/Hindsight Cloud API key/credential
HINDSIGHT_NAMESPACE=default
HINDSIGHT_BANK_ID=Cerebro
