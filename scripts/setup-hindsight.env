HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=op://Optemization Automation/Hindsight Cloud API key/credential
HINDSIGHT_NAMESPACE=default
# Spec calls this `optemization-cerebro`; the cloud auto-created `Cerebro` at
# signup and the API key is scoped to that bank. Functionally identical — keep
# this value in lockstep with whatever bank the API key actually grants access
# to. If we ever provision a fresh, properly-named bank we can rename here.
HINDSIGHT_BANK_ID=Cerebro
