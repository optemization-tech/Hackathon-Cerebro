# Notion integration token (set via ntn workers env push for deployed workers)
NOTION_API_TOKEN=ntn_...

# Glossary DB data source ID — where proposed candidates are written.
# Resolve with: ntn datasources resolve <glossary-database-id>
GLOSSARY_DATA_SOURCE_ID=

# Min number of mentions across STM rows before a term is proposed (default: 3)
# MIN_FREQUENCY=3
